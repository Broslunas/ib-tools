#!/usr/bin/env bash
# genmake: genera el Makefile y los archivos de un ejercicio de C++,
# preguntando paso a paso.  /  Creates the Makefile and files of a C++
# exercise, asking step by step.
#
# Uso / Usage: genmake [nombre|name] [-y]
#   -y      acepta todos los valores por defecto / accept all defaults
#
# Archivos / Files (ejercicio "cuadrado"):
#   Makefile, cuadrado_main.cc, [cuadrado.cc + cuadrado.h]
# Los .cc y .h que ya existen no se tocan nunca.

set -euo pipefail

# ---------- Configuración e idioma ----------
config="${XDG_CONFIG_HOME:-$HOME/.config}/ib-tools/config"
# shellcheck disable=SC1090
[[ -f "$config" ]] && source "$config"

idioma() {
  case "${IB_LANG:-${IB_IDIOMA:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}}" in
    es*|ES*) L=es ;;
    *) L=en ;;
  esac
}
idioma

declare -A ES EN
ES=(
  [usage]='Uso: genmake [nombre] [-y]   (ej: genmake cuadrado)\n'
  [unknown_opt]='Opción desconocida: %s (usa -h para ver el uso)\n'
  [missing_data]='Error: faltan tus datos (nombre y correo). Ejecuta ib-config.\n'
  [invalid_name]="Error: nombre no válido: '%s'\n"
  [invalid_again]='  Nombre no válido (solo letras, números, _ . -).\n'
  [name_fail]='Error: no se pudo obtener un nombre válido.\n'
  [num_hint]='  Escribe un número entero entre 0 y 20.\n'
  [num_fail]='Error: número no válido.\n'
  [same_name]='Error: el archivo de funciones no puede llamarse igual que el principal.\n'
  [yn_marks_n]='s/N'
  [yn_marks_s]='S/n'
  [q_name]='Nombre del ejercicio (será también el del ejecutable)'
  [q_main]='Nombre del archivo del programa principal (con el main)'
  [q_funcs]='¿Crear un archivo de funciones?'
  [q_funcs_name]='Nombre del archivo de funciones (.cc y .h)'
  [q_default]='¿Añadir las funciones por defecto (PrintProgramPurpose y CheckCorrectParameters)?'
  [q_nargs]='¿Cuántos argumentos espera el programa (sin contar su nombre)?'
  [q_argname]='Nombre del argumento %s'
  [q_desc]='¿Qué hace el programa? (descripción corta)'
  [q_confirm]='¿Crear estos archivos?'
  [def_arg]='argumento'
  [placeholder_desc]='<describe aquí qué hace>'
  [summary]='Resumen:'
  [l_exec]='Ejecutable'
  [l_defaults]='Funciones por defecto'
  [l_goal]='Objetivo'
  [v_main]='programa principal (%s)'
  [v_funcs]='funciones (%s)'
  [v_protos]='prototipos (%s)'
  [v_defaults]='%s argumento(s):%s'
  [v_none]=' ninguno'
  [st_new]='nuevo'
  [st_exists]='ya existe, no se toca'
  [mk_rewrite]='se reescribe'
  [cancelled]='Cancelado, no se ha creado nada.\n'
  [mk_created]="Makefile creado para '%s'.\n"
  [created]='%s creado.\n'
  [exists]='%s ya existe, no se toca.\n'
  [warn_main]='Aviso: añade tú las llamadas a PrintProgramPurpose y CheckCorrectParameters en %s.\n'
)
EN=(
  [usage]='Usage: genmake [name] [-y]   (e.g. genmake square)\n'
  [unknown_opt]='Unknown option: %s (use -h for usage)\n'
  [missing_data]='Error: your details (name and email) are missing. Run ib-config.\n'
  [invalid_name]="Error: invalid name: '%s'\n"
  [invalid_again]='  Invalid name (letters, numbers, _ . - only).\n'
  [name_fail]='Error: could not get a valid name.\n'
  [num_hint]='  Enter an integer between 0 and 20.\n'
  [num_fail]='Error: invalid number.\n'
  [same_name]='Error: the functions file cannot have the same name as the main file.\n'
  [yn_marks_n]='y/N'
  [yn_marks_s]='Y/n'
  [q_name]="Exercise name (also the executable's name)"
  [q_main]='Name of the main program file (the one with main())'
  [q_funcs]='Create a functions file?'
  [q_funcs_name]='Name of the functions file (.cc and .h)'
  [q_default]='Add the default functions (PrintProgramPurpose and CheckCorrectParameters)?'
  [q_nargs]='How many arguments does the program expect (not counting its name)?'
  [q_argname]='Name of argument %s'
  [q_desc]='What does the program do? (short description)'
  [q_confirm]='Create these files?'
  [def_arg]='argument'
  [placeholder_desc]='<describe what it does here>'
  [summary]='Summary:'
  [l_exec]='Executable'
  [l_defaults]='Default functions'
  [l_goal]='Goal'
  [v_main]='main program (%s)'
  [v_funcs]='functions (%s)'
  [v_protos]='prototypes (%s)'
  [v_defaults]='%s argument(s):%s'
  [v_none]=' none'
  [st_new]='new'
  [st_exists]='already exists, left untouched'
  [mk_rewrite]='will be rewritten'
  [cancelled]='Cancelled, nothing was created.\n'
  [mk_created]="Makefile created for '%s'.\n"
  [created]='%s created.\n'
  [exists]='%s already exists, left untouched.\n'
  [warn_main]='Note: add the calls to PrintProgramPurpose and CheckCorrectParameters to %s yourself.\n'
)

# t clave [args...]: imprime el mensaje en el idioma activo
t() {
  local key="$1" fmt
  shift
  if [[ "$L" == es ]]; then fmt="${ES[$key]}"; else fmt="${EN[$key]}"; fi
  # shellcheck disable=SC2059
  printf "$fmt" "$@"
}

# ---------- Argumentos ----------
auto=0
args=()
for a in "$@"; do
  case "$a" in
    -y) auto=1 ;;
    -h|--help)
      t usage
      exit 0 ;;
    -*) t unknown_opt "$a" >&2; exit 1 ;;
    *) args+=("$a") ;;
  esac
done

if [[ ${#args[@]} -gt 1 ]]; then
  t usage >&2
  exit 1
fi

skeleton="$HOME/.vim/skeleton.cc"
fecha="$(date +'%b %d %Y')"

valido() { [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]]; }

# ---------- Tus datos ----------
if [[ -z "${IB_NOMBRE:-}" || -z "${IB_EMAIL:-}" ]]; then
  if [[ -t 0 ]] && command -v ib-config >/dev/null; then
    ib-config
    # shellcheck disable=SC1090
    [[ -f "$config" ]] && source "$config"
    idioma
  fi
fi
if [[ -z "${IB_NOMBRE:-}" || -z "${IB_EMAIL:-}" ]]; then
  t missing_data >&2
  exit 1
fi
autor="$IB_NOMBRE $IB_EMAIL"

# ---------- Utilidades para preguntar ----------
# leer "texto" variable "defecto"  (Enter = defecto)
leer() {
  local texto="$1" var="$2" def="${3:-}" resp=""
  if [[ $auto -eq 1 ]]; then
    printf -v "$var" '%s' "$def"
    return 0
  fi
  if [[ -n "$def" ]]; then
    read -rp "$texto [$def]: " resp || resp=""
  else
    read -rp "$texto: " resp || resp=""
  fi
  printf -v "$var" '%s' "${resp:-$def}"
}

# leer_nombre "texto" variable "defecto"  (solo letras, números, _ . -)
leer_nombre() {
  local intentos=0 valor=""
  while true; do
    leer "$1" valor "${3:-}"
    valor="${valor%.cc}"
    valor="${valor%.h}"
    if valido "$valor"; then
      printf -v "$2" '%s' "$valor"
      return 0
    fi
    intentos=$((intentos + 1))
    t invalid_again >&2
    if [[ $auto -eq 1 || $intentos -ge 3 ]]; then
      t name_fail >&2
      exit 1
    fi
  done
}

# leer_numero "texto" variable "defecto" (entero de 0 a 20)
leer_numero() {
  local intentos=0 valor=""
  while true; do
    leer "$1" valor "${3:-}"
    if [[ "$valor" =~ ^[0-9]+$ && "$valor" -le 20 ]]; then
      printf -v "$2" '%s' "$valor"
      return 0
    fi
    intentos=$((intentos + 1))
    t num_hint >&2
    if [[ $auto -eq 1 || $intentos -ge 3 ]]; then
      t num_fail >&2
      exit 1
    fi
  done
}

# si_no "texto" defecto(s|n): devuelve 0 si la respuesta es sí
si_no() {
  local texto="$1" def="${2:-n}" resp="" marca
  if [[ "$def" == "s" ]]; then marca="$(t yn_marks_s)"; else marca="$(t yn_marks_n)"; fi
  if [[ $auto -eq 1 ]]; then
    [[ "$def" == "s" ]]
    return
  fi
  read -rp "$texto [$marca] " resp || resp=""
  resp="${resp:-$def}"
  [[ "$resp" =~ ^[sSyY]$ ]]
}

# ---------- Preguntas ----------
if [[ -n "${args[0]:-}" ]]; then
  nombre="${args[0]%.cc}"
  nombre="${nombre%_main}"
  if ! valido "$nombre"; then
    t invalid_name "$nombre" >&2
    exit 1
  fi
else
  sugerido="$(basename "$PWD")"
  valido "$sugerido" || sugerido=""
  leer_nombre "$(t q_name)" nombre "$sugerido"
fi

leer_nombre "$(t q_main)" principal "${nombre}_main"

usa_funciones=0
defecto=0
funciones=""
n_args=1
arg_nombres=()
descripcion=""

if si_no "$(t q_funcs)" n; then
  usa_funciones=1
  leer_nombre "$(t q_funcs_name)" funciones "$nombre"
  if [[ "$funciones" == "$principal" ]]; then
    t same_name >&2
    exit 1
  fi

  if si_no "$(t q_default)" n; then
    defecto=1
    leer_numero "$(t q_nargs)" n_args "1"
    for ((i = 1; i <= n_args; i++)); do
      if [[ "$n_args" -eq 1 ]]; then def_arg="$(t def_arg)"; else def_arg="$(t def_arg)$i"; fi
      leer_nombre "$(t q_argname "$i")" nom_arg "$def_arg"
      arg_nombres+=("$nom_arg")
    done
    leer "$(t q_desc)" descripcion ""
  fi
fi

# ---------- Valores derivados ----------
uso=""
for a in "${arg_nombres[@]+"${arg_nombres[@]}"}"; do
  uso+=" <$a>"
done

descripcion="${descripcion%.}"
if [[ -z "$descripcion" ]]; then
  descripcion="$(t placeholder_desc)"
fi
# Escapar \ y " para meterlo dentro de un literal de C++
descripcion_cc="${descripcion//\\/\\\\}"
descripcion_cc="${descripcion_cc//\"/\\\"}"

# ---------- Resumen y confirmación ----------
estado() { if [[ -e "$1" ]]; then t st_exists; else t st_new; fi; }

if [[ $auto -eq 0 ]]; then
  echo
  t summary; echo
  printf '  %-26s %s\n' "$(t l_exec)" "$nombre"
  if [[ -e Makefile ]]; then
    printf '  %-26s %s\n' "Makefile" "$(t mk_rewrite)"
  else
    printf '  %-26s %s\n' "Makefile" "$(t st_new)"
  fi
  printf '  %-26s %s\n' "$principal.cc" "$(t v_main "$(estado "$principal.cc")")"
  if [[ $usa_funciones -eq 1 ]]; then
    printf '  %-26s %s\n' "$funciones.cc" "$(t v_funcs "$(estado "$funciones.cc")")"
    printf '  %-26s %s\n' "$funciones.h" "$(t v_protos "$(estado "$funciones.h")")"
  fi
  if [[ $defecto -eq 1 ]]; then
    printf '  %-26s %s\n' "$(t l_defaults)" "$(t v_defaults "$n_args" "${uso:-$(t v_none)}")"
    printf '  %-26s %s\n' "$(t l_goal)" "$descripcion"
  fi
  echo
  if ! si_no "$(t q_confirm)" s; then
    t cancelled
    exit 0
  fi
fi

# ---------- Texto de las funciones por defecto ----------
texto_constante() {
  if [[ "$L" == es ]]; then
    echo '// Número de argumentos esperados (sin contar el nombre del programa).'
  else
    echo '// Number of expected arguments (not counting the program name).'
  fi
}

# Prototipos (para el .h)
texto_prototipos() {
  if [[ "$L" == es ]]; then
    cat <<'EOF'
// Imprime una breve descripción de lo que hace el programa.
void PrintProgramPurpose();

// Comprueba que se han pasado los argumentos esperados.
// Si no es así, muestra el modo de uso y termina el programa.
void CheckCorrectParameters(const int argc, char* argv[],
                            const int kCorrectNumber);
EOF
  else
    cat <<'EOF'
// Prints a short description of what the program does.
void PrintProgramPurpose();

// Checks that the expected number of arguments was passed.
// If not, shows the usage and ends the program.
void CheckCorrectParameters(const int argc, char* argv[],
                            const int kCorrectNumber);
EOF
  fi
}

# Definiciones (para <funciones>.cc)
texto_definiciones() {
  if [[ "$L" == es ]]; then
    cat <<EOF
// Imprime una breve descripción de lo que hace el programa.
void PrintProgramPurpose() {
  std::cout << "Este programa $descripcion_cc.\\n";
}

// Comprueba que se han pasado los argumentos esperados.
// Si no es así, muestra el modo de uso y termina el programa.
void CheckCorrectParameters(const int argc, char* argv[],
                            const int kCorrectNumber) {
  if (argc - 1 != kCorrectNumber) {
    std::cerr << "Error: número de argumentos incorrecto.\\n"
              << "Modo de uso: " << argv[0] << "$uso\\n";
    exit(EXIT_FAILURE);
  }
}
EOF
  else
    cat <<EOF
// Prints a short description of what the program does.
void PrintProgramPurpose() {
  std::cout << "This program $descripcion_cc.\\n";
}

// Checks that the expected number of arguments was passed.
// If not, shows the usage and ends the program.
void CheckCorrectParameters(const int argc, char* argv[],
                            const int kCorrectNumber) {
  if (argc - 1 != kCorrectNumber) {
    std::cerr << "Error: wrong number of arguments.\\n"
              << "Usage: " << argv[0] << "$uso\\n";
    exit(EXIT_FAILURE);
  }
}
EOF
  fi
}

# ---------- Cabeceras con los datos del usuario ----------
# Líneas de institución (se omiten las vacías)
lineas_institucion() {
  local asig_curso
  asig_curso="${IB_ASIGNATURA:-}"
  if [[ -n "${IB_CURSO:-}" ]]; then
    asig_curso="${asig_curso:+$asig_curso }$IB_CURSO"
  fi
  [[ -n "${IB_UNIVERSIDAD:-}" ]] && echo "$IB_UNIVERSIDAD"
  [[ -n "${IB_CENTRO:-}" ]] && echo "$IB_CENTRO"
  [[ -n "${IB_TITULACION:-}" ]] && echo "$IB_TITULACION"
  [[ -n "$asig_curso" ]] && echo "$asig_curso"
  return 0
}

# Cabecera de un archivo de código
cabecera() {
  local linea lineas
  lineas="$(lineas_institucion)"
  echo "/**"
  if [[ -n "$lineas" ]]; then
    while IFS= read -r linea; do
      echo " * $linea"
    done <<< "$lineas"
    echo " *"
  fi
  cat <<EOF
 * @file $1
 * @author $autor
 * @date $fecha
 * @brief
 * @bug There are no known bugs
 * @see
 */
EOF
}

# Cabecera del Makefile
cabecera_make() {
  local linea lineas
  lineas="$(lineas_institucion)"
  if [[ -n "$lineas" ]]; then
    while IFS= read -r linea; do
      echo "# $linea"
    done <<< "$lineas"
    echo "#"
  fi
  echo "# @author $autor"
}

# ---------- Creación de .h / .cc ----------
crear_header() {
  local base="$1" guard
  guard="$(echo "${base}_H" | tr '[:lower:].-' '[:upper:]__')"
  if [[ -e "$base.h" ]]; then
    t exists "$base.h"
    return 0
  fi
  {
    cabecera "$base.h"
    printf '\n#ifndef %s\n#define %s\n\n' "$guard" "$guard"
    if [[ $defecto -eq 1 ]]; then
      texto_prototipos
      printf '\n'
    else
      printf '\n\n'
    fi
    printf '#endif  // %s\n' "$guard"
  } > "$base.h"
  t created "$base.h"
}

crear_fuente() {
  local base="$1"
  if [[ -e "$base.cc" ]]; then
    t exists "$base.cc"
    return 0
  fi
  {
    cabecera "$base.cc"
    printf '\n#include "%s.h"\n\n' "$base"
    if [[ $defecto -eq 1 ]]; then
      printf '#include <cstdlib>\n#include <iostream>\n\n'
      texto_definiciones
    else
      printf '#include <iostream>\n\n'
    fi
  } > "$base.cc"
  t created "$base.cc"
}

# ---------- Makefile ----------
{
  cabecera_make
  echo
  if [[ "$L" == es ]]; then
    cat <<'EOF'
# =========================================================
# CONFIGURACIÓN DEL PROYECTO
# PROGRAMA: nombre del ejecutable
# MAIN: nombre (sin .cc) del archivo que contiene el main()
# =========================================================

# Solo cambias estas variables para cada ejercicio/programa
PROGRAMA := __NOMBRE__
MAIN     := __MAIN__

# Configuración del ejecutable y archivos fuente
TARGET   := $(PROGRAMA)
MAIN_SRC := $(MAIN).cc
FUNC_SRC := $(filter-out $(MAIN_SRC),$(wildcard *.cc))
# Compilador y banderas
CXX      := g++
CXXFLAGS := -Wall -Wextra -std=c++17

# Generación automática de archivos objeto (.o)
OBJS     := $(MAIN_SRC:.cc=.o) $(FUNC_SRC:.cc=.o)

# Regla principal
all: $(TARGET)

# Enlace del ejecutable
$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

# Compilación de .cc a .o
%.o: %.cc $(wildcard *.h)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Limpieza de binarios, objetos y archivos de intercambio de Vim
clean:
	rm -f *.o $(TARGET) .*.swp

.PHONY: all clean
EOF
  else
    cat <<'EOF'
# =========================================================
# PROJECT SETTINGS
# PROGRAMA: name of the executable
# MAIN: name (without .cc) of the file that contains main()
# =========================================================

# You only change these variables for each exercise/program
PROGRAMA := __NOMBRE__
MAIN     := __MAIN__

# Executable and source files settings
TARGET   := $(PROGRAMA)
MAIN_SRC := $(MAIN).cc
FUNC_SRC := $(filter-out $(MAIN_SRC),$(wildcard *.cc))
# Compiler and flags
CXX      := g++
CXXFLAGS := -Wall -Wextra -std=c++17

# Automatic generation of object files (.o)
OBJS     := $(MAIN_SRC:.cc=.o) $(FUNC_SRC:.cc=.o)

# Main rule
all: $(TARGET)

# Link the executable
$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

# Compile .cc into .o
%.o: %.cc $(wildcard *.h)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Remove binaries, objects and Vim swap files
clean:
	rm -f *.o $(TARGET) .*.swp

.PHONY: all clean
EOF
  fi
} > Makefile
sed -i -e "s/__NOMBRE__/$nombre/" -e "s/__MAIN__/$principal/" Makefile
t mk_created "$nombre"

# ---------- Programa principal ----------
if [[ -e "$principal.cc" ]]; then
  t exists "$principal.cc"
  if [[ $defecto -eq 1 ]]; then
    t warn_main "$principal.cc"
  fi
else
  if [[ -f "$skeleton" ]]; then
    cp "$skeleton" "$principal.cc"
    sed -i -e "s/FILENAME/$principal.cc/" -e "s/DATE/$fecha/" "$principal.cc"
  else
    { cabecera "$principal.cc"
      printf '\n#include <iostream>\n\nint main() {\n\n  return 0;\n}\n'
    } > "$principal.cc"
  fi

  # Include de la cabecera de funciones
  if [[ $usa_funciones -eq 1 ]]; then
    if grep -q '^#include <iostream>' "$principal.cc"; then
      modo="despues"
    else
      modo="antes"
    fi
    awk -v inc="$funciones.h" -v modo="$modo" '
      !hecho && ((modo == "despues" && /^#include <iostream>/) ||
                 (modo == "antes" && /^#include/)) {
        if (modo == "despues") { print; print "" }
        print "#include \"" inc "\""
        if (modo == "antes") { print ""; print }
        hecho = 1
        next
      }
      { print }
    ' "$principal.cc" > "$principal.cc.tmp" && mv "$principal.cc.tmp" "$principal.cc"
  fi

  # Comprobación de argumentos: sustituye "int main() {"
  if [[ $defecto -eq 1 ]]; then
    bloque="$(mktemp)"
    {
      texto_constante
      echo "const int kCorrectNumber = $n_args;"
      echo
      echo 'int main(int argc, char* argv[]) {'
      echo '  PrintProgramPurpose();'
      echo '  CheckCorrectParameters(argc, argv, kCorrectNumber);'
    } > "$bloque"

    awk -v f="$bloque" '
      !hecho && /^int main\(\) \{/ {
        while ((getline linea < f) > 0) print linea
        hecho = 1
        next
      }
      { print }
    ' "$principal.cc" > "$principal.cc.tmp" && mv "$principal.cc.tmp" "$principal.cc"
    rm -f "$bloque"
  fi
  t created "$principal.cc"
fi

# ---------- Archivo de funciones ----------
if [[ $usa_funciones -eq 1 ]]; then
  crear_header "$funciones"
  crear_fuente "$funciones"
fi

# ---------- Aviso discreto de versión nueva (como mucho una vez a la semana) ----------
if [[ $auto -eq 0 ]] && command -v ib-update >/dev/null; then
  ib-update --aviso || true
fi
